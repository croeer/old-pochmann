---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#111318" />
    <title>BLD Memo Scanner</title>
    <meta name="description" content="Scan a 3x3 cube and generate Old Pochmann Speffz memo for edges and corners." />
  </head>
  <body>
    <main class="shell">
      <header>
        <div>
          <p class="eyebrow">3×3 BLINDFOLD · OLD POCHMANN</p>
          <h1>Scan cube. Get memo.</h1>
          <p class="sub">Speffz A–X in your face order: U, L, F, R, B, D.</p>
        </div>
        <button id="restart" class="ghost">Start over</button>
      </header>

      <section class="panel" id="scan-panel">
        <div class="stepbar">
          <div><span id="step-num">1</span>/6</div>
          <div class="progress"><div id="progress-fill"></div></div>
        </div>

        <div class="scan-layout">
          <div class="camera-wrap">
            <video id="camera" autoplay playsinline muted></video>
            <div class="guide" aria-hidden="true">
              <div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div>
            </div>
            <div id="camera-message" class="camera-message">Camera not started</div>
          </div>

          <div class="instructions">
            <p class="eyebrow">SHOW THIS FACE</p>
            <div class="face-title"><span id="face-name">U</span> <small id="face-range">A–D</small></div>
            <p id="hold-hint">Top face. Keep the B face toward the top of the camera frame.</p>
            <div class="actions">
              <button id="start-camera">Start camera</button>
              <button id="capture" disabled>Capture face</button>
              <button id="undo" class="ghost" disabled>Back</button>
            </div>
            <p class="hint">Fill the square with the face. Avoid glare; the nine dots are sampled at capture time.</p>
          </div>
        </div>
      </section>

      <section class="panel" id="review-panel" hidden>
        <div class="section-head">
          <div>
            <p class="eyebrow">REVIEW</p>
            <h2>Cube model</h2>
          </div>
          <p class="hint">Tap any sticker to cycle its detected face/color if the camera guessed wrong.</p>
        </div>
        <div id="cube-net" class="cube-net"></div>
        <div id="validation" class="validation"></div>
        <div class="actions">
          <button id="solve-memo">Generate memo</button>
          <button id="rescan" class="ghost">Rescan</button>
        </div>
      </section>

      <section id="result-panel" hidden>
        <div id="parity-card" class="parity-card" hidden>
          <strong>Parity</strong>
          <span>Odd edge target count — your Old Pochmann parity case is present.</span>
        </div>
        <div class="result-grid">
          <article class="panel memo-card">
            <div class="section-head"><div><p class="eyebrow">EDGE MEMO</p><h2>Buffer UR · B</h2></div><span id="edge-count"></span></div>
            <div id="edge-memo" class="memo"></div>
            <div id="edge-cycles" class="cycles"></div>
            <div id="edge-notes" class="notes"></div>
          </article>
          <article class="panel memo-card">
            <div class="section-head"><div><p class="eyebrow">CORNER MEMO</p><h2>Buffer UBL · A</h2></div><span id="corner-count"></span></div>
            <div id="corner-memo" class="memo"></div>
            <div id="corner-cycles" class="cycles"></div>
            <div id="corner-notes" class="notes"></div>
          </article>
        </div>
        <div class="panel result-cube-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">SCANNED CUBE</p>
              <h2>Cube model</h2>
            </div>
            <p class="hint result-model-hint">Read-only. Use Edit scan to correct a sticker.</p>
          </div>
          <div id="result-cube-net" class="cube-net cube-net-result"></div>
        </div>
        <div class="panel compact">
          <div class="actions">
            <button id="copy-memo">Copy memo</button>
            <button id="edit-scan" class="ghost">Edit scan</button>
            <button id="new-scan" class="ghost">New cube</button>
          </div>
        </div>
      </section>
    </main>

    <script>
      import { FACE_ORDER, FACE_DEFS, blankSolvedState, faceletIndex, faceOfLetter, letterInfo, memoFromState } from '../lib/cube';
      import { sampleGrid, colorDistance } from '../lib/color';

      const $ = (id) => document.getElementById(id);
      const faceColors = {
        U: '#ffd52a', L: '#2968db', F: '#e43b32', R: '#22b85a', B: '#ff8c1a', D: '#f4f4ef'
      };
      const hints = {
        U: 'Top face. Keep the B face toward the top of the camera frame.',
        L: 'Left face. Keep U toward the top of the camera frame.',
        F: 'Front face. Keep U toward the top of the camera frame.',
        R: 'Right face. Keep U toward the top of the camera frame.',
        B: 'Back face. Keep U toward the top of the camera frame.',
        D: 'Bottom face. Keep F toward the top of the camera frame.'
      };

      let stream = null;
      let step = 0;
      let rawScans = {};
      let state = blankSolvedState();
      let modelReady = false;

      function letterRange(face) {
        const off = FACE_DEFS[face].off;
        return `${String.fromCharCode(65 + off)}–${String.fromCharCode(68 + off)}`;
      }

      function updateStep() {
        const face = FACE_ORDER[step];
        $('step-num').textContent = String(step + 1);
        $('progress-fill').style.width = `${(step / 6) * 100}%`;
        $('face-name').textContent = face;
        $('face-range').textContent = letterRange(face);
        $('hold-hint').textContent = hints[face];
        $('undo').disabled = step === 0;
      }


      async function startCamera() {
        try {
          stream?.getTracks().forEach(t => t.stop());
          stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: { ideal: 'environment' }, width: { ideal: 1280 }, height: { ideal: 1280 } },
            audio: false
          });
          $('camera').srcObject = stream;
          await $('camera').play();
          $('capture').disabled = false;
          $('camera-message').hidden = true;
          $('start-camera').textContent = 'Restart camera';
        } catch (error) {
          $('camera-message').hidden = false;
          $('camera-message').textContent = 'Camera permission is required. Use HTTPS or localhost and allow camera access.';
        }
      }

      function capture() {
        const face = FACE_ORDER[step];
        rawScans[face] = sampleGrid($('camera'));
        if (step < 5) {
          step++;
          updateStep();
        } else {
          buildModel();
        }
      }

      function buildModel() {
        // Every captured center is the color reference for that logical face.
        const refs = Object.fromEntries(FACE_ORDER.map(face => [face, rawScans[face][4]]));
        state = blankSolvedState();
        for (const face of FACE_ORDER) {
          rawScans[face].forEach((rgb, i) => {
            const detected = FACE_ORDER.reduce((best, candidate) => {
              const d = colorDistance(rgb, refs[candidate]);
              return d < best.d ? { face: candidate, d } : best;
            }, { face: FACE_ORDER[0], d: Infinity }).face;
            state[faceletIndex(face, Math.floor(i / 3), i % 3)] = detected;
          });
          // Centers define orientation and cannot be anything else.
          state[faceletIndex(face, 1, 1)] = face;
        }
        modelReady = true;
        showReview();
      }

      function showReview() {
        $('scan-panel').hidden = true;
        $('result-panel').hidden = true;
        $('review-panel').hidden = false;
        renderCubeNet('cube-net', true);
        renderValidation();
      }

      function renderCubeNet(targetId, editable = false) {
        const net = $(targetId);
        net.replaceChildren();
        const layout = [
          ['U', 0, 1], ['L', 1, 0], ['F', 1, 1], ['R', 1, 2], ['B', 1, 3], ['D', 2, 1]
        ];
        for (const [face, row, col] of layout) {
          const f = document.createElement('div');
          f.className = 'net-face';
          f.style.gridRow = String(row + 1);
          f.style.gridColumn = String(col + 1);
          for (let r = 0; r < 3; r++) for (let c = 0; c < 3; c++) {
            const idx = faceletIndex(face, r, c);
            const cell = document.createElement(editable ? 'button' : 'div');
            cell.className = `sticker${editable ? '' : ' sticker-readonly'}`;
            cell.style.background = faceColors[state[idx]];
            const info = letterInfo[idx];
            cell.textContent = info?.letter ?? (r === 1 && c === 1 ? face : '');
            if (editable) {
              if (r === 1 && c === 1) cell.disabled = true;
              else cell.onclick = () => {
                const current = FACE_ORDER.indexOf(state[idx]);
                state[idx] = FACE_ORDER[(current + 1) % FACE_ORDER.length];
                renderCubeNet('cube-net', true);
                renderValidation();
              };
            }
            f.append(cell);
          }
          net.append(f);
        }
      }

      function renderValidation() {
        const result = memoFromState(state);
        const box = $('validation');
        box.replaceChildren();
        if (!result.errors.length) {
          box.className = 'validation good';
          box.textContent = 'Cube pieces are internally consistent. Ready to trace.';
          $('solve-memo').disabled = false;
        } else {
          box.className = 'validation bad';
          box.innerHTML = `<strong>Scan needs correction</strong><br>${result.errors.slice(0, 4).map(x => `• ${x}`).join('<br>')}`;
          $('solve-memo').disabled = true;
        }
      }

      function pairTiles(letters) {
        if (!letters.length) return '<span class="empty">Solved — no targets.</span>';
        let html = '';
        for (let i = 0; i < letters.length; i += 2) {
          const a = letters[i], b = letters[i + 1];
          html += `<div class="pair"><span style="--tile:${faceColors[faceOfLetter(a)]}">${a}</span>${b ? `<span style="--tile:${faceColors[faceOfLetter(b)]}">${b}</span>` : '<span class="blank">·</span>'}</div>`;
        }
        return html;
      }

      function notesHtml(result) {
        const notes = [];
        if (result.bufferMisoriented) notes.push('Buffer piece is flipped/twisted in place.');
        if (result.misoriented.length) notes.push(`Misoriented in place: ${result.misoriented.join(', ')}.`);
        return notes.join('<br>');
      }

      function generateMemo() {
        const result = memoFromState(state, 'B', 'A');
        if (result.errors.length) return renderValidation();
        $('review-panel').hidden = true;
        $('result-panel').hidden = false;
        $('parity-card').hidden = !result.parity;

        $('edge-count').textContent = `${result.edges.letters.length} targets`;
        $('corner-count').textContent = `${result.corners.letters.length} targets`;
        $('edge-memo').innerHTML = pairTiles(result.edges.letters);
        $('corner-memo').innerHTML = pairTiles(result.corners.letters);
        $('edge-cycles').textContent = `cycles: ${result.edges.cycles.map(c => `${c.isBreak ? '↳ ' : ''}${c.letters.join('')}`).join('  ·  ') || '—'}`;
        $('corner-cycles').textContent = `cycles: ${result.corners.cycles.map(c => `${c.isBreak ? '↳ ' : ''}${c.letters.join('')}`).join('  ·  ') || '—'}`;
        $('edge-notes').innerHTML = notesHtml(result.edges);
        $('corner-notes').innerHTML = notesHtml(result.corners);
        renderCubeNet('result-cube-net', false);
      }

      function resetAll() {
        step = 0;
        rawScans = {};
        state = blankSolvedState();
        modelReady = false;
        $('scan-panel').hidden = false;
        $('review-panel').hidden = true;
        $('result-panel').hidden = true;
        $('progress-fill').style.width = '0%';
        updateStep();
      }

      $('start-camera').onclick = startCamera;
      $('capture').onclick = capture;
      $('undo').onclick = () => { if (step > 0) { step--; updateStep(); } };
      $('restart').onclick = resetAll;
      $('rescan').onclick = resetAll;
      $('solve-memo').onclick = generateMemo;
      $('edit-scan').onclick = showReview;
      $('new-scan').onclick = resetAll;
      $('copy-memo').onclick = async () => {
        const result = memoFromState(state, 'B', 'A');
        const text = `Edges: ${result.edges.letters.join('')}\nCorners: ${result.corners.letters.join('')}\nParity: ${result.parity ? 'YES' : 'no'}`;
        await navigator.clipboard.writeText(text);
        $('copy-memo').textContent = 'Copied';
        setTimeout(() => $('copy-memo').textContent = 'Copy memo', 1200);
      };

      updateStep();
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; --bg:#0c0e12; --panel:#151820; --line:#282d39; --muted:#9299aa; --text:#f5f7fa; --accent:#7c5cff; }
  * { box-sizing:border-box; }
  body { margin:0; min-height:100vh; background:radial-gradient(circle at 50% -20%, #22263a 0, var(--bg) 42%); color:var(--text); }
  button { font:inherit; }
  .shell { width:min(1080px, calc(100% - 28px)); margin:0 auto; padding:32px 0 64px; }
  header { display:flex; justify-content:space-between; gap:24px; align-items:flex-start; margin-bottom:20px; }
  h1,h2,p { margin:0; } h1 { font-size:clamp(30px, 6vw, 54px); letter-spacing:-.045em; line-height:1; } h2 { font-size:20px; }
  .sub { color:var(--muted); margin-top:10px; }
  .eyebrow { color:#aaa1ff; font-size:11px; letter-spacing:.16em; font-weight:800; margin-bottom:8px; }
  .panel { background:rgba(21,24,32,.92); border:1px solid var(--line); border-radius:18px; padding:18px; box-shadow:0 16px 50px rgba(0,0,0,.18); }
  button { border:1px solid #4b43a6; background:var(--accent); color:white; border-radius:11px; padding:10px 15px; font-weight:750; cursor:pointer; }
  button:disabled { opacity:.38; cursor:not-allowed; }
  button.ghost { background:transparent; border-color:var(--line); color:#d8dce7; }
  .stepbar { display:flex; gap:14px; align-items:center; color:var(--muted); margin-bottom:16px; font-variant-numeric:tabular-nums; }
  .progress { flex:1; height:5px; background:#242835; border-radius:999px; overflow:hidden; } .progress div { height:100%; width:0; background:var(--accent); transition:width .25s ease; }
  .scan-layout { display:grid; grid-template-columns:minmax(0, 1.25fr) minmax(260px, .75fr); gap:24px; }
  .camera-wrap { position:relative; aspect-ratio:1; overflow:hidden; background:#07080b; border-radius:15px; }
  video { width:100%; height:100%; object-fit:cover; }
  .guide { position:absolute; inset:12%; display:grid; grid-template-columns:repeat(3,1fr); grid-template-rows:repeat(3,1fr); border:2px solid rgba(255,255,255,.9); border-radius:14px; box-shadow:0 0 0 999px rgba(0,0,0,.18); pointer-events:none; }
  .guide div { border:1px solid rgba(255,255,255,.45); position:relative; } .guide div::after { content:''; position:absolute; width:8px; height:8px; border-radius:50%; background:white; left:50%; top:50%; transform:translate(-50%,-50%); box-shadow:0 0 0 3px rgba(0,0,0,.24); }
  .camera-message { position:absolute; inset:0; display:grid; place-items:center; text-align:center; padding:24px; color:var(--muted); }
  .instructions { display:flex; flex-direction:column; justify-content:center; } .face-title { font-size:72px; line-height:.9; font-weight:900; letter-spacing:-.08em; } .face-title small { font-size:16px; letter-spacing:.04em; color:var(--muted); vertical-align:middle; }
  #hold-hint { margin-top:16px; color:#d6dae4; line-height:1.5; }
  .actions { display:flex; gap:9px; flex-wrap:wrap; } .hint { color:var(--muted); font-size:13px; line-height:1.5; margin-top:12px; }
  .section-head { display:flex; justify-content:space-between; gap:18px; align-items:flex-start; margin-bottom:16px; }
  .cube-net { display:grid; grid-template-columns:repeat(4, minmax(72px, 112px)); grid-template-rows:repeat(3, auto); gap:8px; justify-content:center; padding:18px 0; overflow:auto; }
  .net-face { display:grid; grid-template-columns:repeat(3,1fr); gap:3px; }
  .sticker { aspect-ratio:1; padding:0; border:1px solid rgba(0,0,0,.45); border-radius:6px; color:#111; text-shadow:0 1px rgba(255,255,255,.2); font-weight:900; min-width:22px; display:grid; place-items:center; }
  .sticker-readonly { cursor:default; }
  .validation { border-radius:11px; padding:12px 14px; margin:12px 0 16px; font-size:14px; line-height:1.5; } .validation.good { background:#12251c; color:#8ce0ad; border:1px solid #25553a; } .validation.bad { background:#2b1719; color:#ff999f; border:1px solid #663036; }
  .parity-card { display:flex; gap:14px; align-items:center; background:#392a0d; border:1px solid #80621b; color:#ffd86b; border-radius:14px; padding:15px 18px; margin-bottom:14px; }
  .result-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; } .memo-card { min-height:250px; }
  .memo { display:flex; flex-wrap:wrap; gap:14px; margin:18px 0; } .pair { display:flex; gap:4px; } .pair span { width:46px; height:46px; display:grid; place-items:center; border-radius:9px; background:var(--tile); color:#111; font-size:22px; font-weight:950; border:1px solid rgba(0,0,0,.35); } .pair .blank { background:transparent; color:var(--muted); border:1px dashed #4b5160; }
  .empty { color:var(--muted); }
  .cycles { color:#a9b0c0; font-family:ui-monospace, SFMono-Regular, Menlo, monospace; font-size:13px; line-height:1.6; } .notes { color:#ffc766; margin-top:10px; font-size:13px; line-height:1.5; }
  .result-cube-panel { margin-top:14px; }
  .cube-net-result { padding-bottom:4px; }
  .result-model-hint { margin-top:0; text-align:right; }
  .compact { margin-top:14px; }
  @media (max-width: 760px) { .shell{width:min(100% - 20px,1080px);padding-top:20px}.scan-layout,.result-grid{grid-template-columns:1fr}.instructions{padding-top:4px}.face-title{font-size:58px}.cube-net{grid-template-columns:repeat(4,72px)}.result-model-hint{text-align:left} header .ghost{display:none} }
</style>
